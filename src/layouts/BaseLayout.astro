---
import '../styles/global.css';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCtaBar from '../components/MobileCtaBar.astro';
import ConsentHead from '../components/ConsentHead.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { site, telHref } from '../config/site';
import { showMobileCta } from '../lib/page';

interface Props {
  title: string;
  description: string;
  /** Path to an image in /public used for social sharing. */
  ogImage?: string;
  /** Extra JSON-LD objects for this page. */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, ogImage = '/og-default.jpg', schema = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const ogImageUrl = new URL(ogImage, site.url).href;

const businessId = `${site.url}/#business`;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': businessId,
  name: site.name,
  legalName: site.legalName,
  url: `${site.url}/`,
  logo: `${site.url}/apple-touch-icon.png`,
  image: ogImageUrl,
  email: site.email,
  ...(site.phone ? { telephone: telHref(site.phone).replace('tel:', '') } : {}),
  identifier: {
    '@type': 'PropertyValue',
    propertyID: 'Companies House company number',
    value: site.companyNumber,
  },
  description: `Window film fitting for homes and businesses: privacy, solar control, frosted and decorative, UV, safety and anti-graffiti films. ${site.serviceAreaLine}.`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.base,
    addressRegion: 'Merseyside',
    addressCountry: 'GB',
  },
  areaServed: site.areasServed.map((name) => ({ '@type': 'AdministrativeArea', name })),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
};

const jsonLd = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0b" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Eclipse Shield logo: a gold shield inside an eclipse" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Consent Mode defaults, then GTM only if analytics was allowed. Kept last so it never delays the first paint. -->
    <ConsentHead />
  </head>
  <body class:list={{ 'has-mobile-cta': showMobileCta(Astro.url.pathname) }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileCtaBar />
    <ConsentBanner />
    <script is:inline>
      /* Look v2 motion (30 Oct 2026). Reveal: cards, steps and photos fade up once as they come into view; nothing
         is hidden without this script and nothing moves under prefers-reduced-motion. Magnetic buttons: on a
         desktop pointer only, a button drifts a little towards the mouse and springs back. */
      (() => {
        const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
        if (!calm && 'IntersectionObserver' in window) {
          const targets = document.querySelectorAll('main .card, main .step, main figure');
          const io = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          }, { rootMargin: '0px 0px -8% 0px' });
          targets.forEach((t, i) => { t.setAttribute('data-reveal', ''); t.style.transitionDelay = `${(i % 3) * 70}ms`; io.observe(t); });
        }
        if (fine && !calm) {
          document.querySelectorAll('.btn').forEach((b) => {
            b.addEventListener('pointermove', (ev) => {
              const r = b.getBoundingClientRect();
              b.style.setProperty('--mx', `${(ev.clientX - r.left - r.width / 2) * 0.18}px`);
              b.style.setProperty('--my', `${(ev.clientY - r.top - r.height / 2) * 0.3}px`);
            });
            b.addEventListener('pointerleave', () => { b.style.setProperty('--mx', '0px'); b.style.setProperty('--my', '0px'); });
          });
        }
      })();
    </script>
  </body>
</html>
