---
// Multi-step quote request form. Posts to the Pages Function at /api/quote.
// Every step is optional except contact details and the privacy consent.
import Icon from './Icon.astro';
import { site, telHref } from '../config/site';
import {
  contactMethods,
  interestForService,
  interests,
  photoLimits,
  positions,
  propertyTypes,
  windowCounts,
  windowTypes,
} from '../data/quote';

const steps = ['Property', 'What you need', 'Windows', 'Photos', 'Location', 'Timing', 'Your details'];
---

<div class="qf-wrap">
  <noscript>
    <p class="qf-noscript">
      Our quote form needs JavaScript. You can also email <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.phone && <> or call <a href={telHref(site.phone)}>{site.phone}</a></>}.
    </p>
  </noscript>

  <form
    id="quote-form"
    class="qf"
    action="/api/quote"
    method="post"
    enctype="multipart/form-data"
    novalidate
    data-total={steps.length}
    data-sitekey={site.turnstileSiteKey}
    data-max-files={photoLimits.maxFiles}
    data-resize={photoLimits.resizeTo}
    data-service-map={JSON.stringify(interestForService)}
  >
    <div class="qf__progress">
      <p class="qf__count" aria-live="polite">
        Step <span data-current>1</span> of {steps.length}: <span data-step-name>{steps[0]}</span>
      </p>
      <div class="qf__bar" aria-hidden="true"><span data-bar></span></div>
    </div>

    <p class="qf__hint">All questions are optional except your contact details. Skip anything you’re not sure about.</p>

    <!-- Honeypot: hidden from people, tempting for bots. The name and label deliberately mean nothing
         to browser autofill (a "Company website" field got filled with saved details, silently dropping quotes). -->
    <div class="qf__hp" aria-hidden="true">
      <label>Leave this empty <input type="text" name="qf_hp_x" tabindex="-1" autocomplete="off" data-lpignore="true" data-1p-ignore /></label>
    </div>
    <input type="hidden" name="source" />

    <!-- 1. Property -->
    <fieldset class="qf__step" data-step="1">
      <legend><span class="qf__q" tabindex="-1">What type of property is it?</span></legend>
      <div class="qf__options qf__options--cards">
        {
          propertyTypes.map((o) => (
            <label class="qf__option">
              <input type="radio" name="property_type" value={o.value} />
              <span>{o.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- 2. What they want -->
    <fieldset class="qf__step" data-step="2">
      <legend><span class="qf__q" tabindex="-1">What would you like the film to do?</span></legend>
      <p class="qf__sub">Choose as many as you like.</p>
      <div class="qf__options">
        {
          interests.map((o) => (
            <label class="qf__option">
              <input type="checkbox" name="interests" value={o.value} />
              <span>{o.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <!-- 3. Windows -->
    <fieldset class="qf__step" data-step="3">
      <legend><span class="qf__q" tabindex="-1">Tell us about the windows</span></legend>

      <div class="qf__field">
        <label for="qf-window-count">Roughly how many windows or panes?</label>
        <select id="qf-window-count" name="window_count">
          <option value="">Choose…</option>
          {windowCounts.map((c) => <option value={c}>{c}</option>)}
        </select>
      </div>

      <div class="qf__field">
        <label for="qf-window-size">Rough size or total area, if you know it</label>
        <input id="qf-window-size" name="window_size" type="text" placeholder="For example 2 windows 1.2 × 1 m, or about 10 m²" />
        <label class="qf__inline">
          <input type="checkbox" name="window_size_not_sure" value="yes" />
          <span>I’m not sure</span>
        </label>
      </div>

      <fieldset class="qf__group">
        <legend>Type of glass</legend>
        <div class="qf__options">
          {
            windowTypes.map((o) => (
              <label class="qf__option">
                <input type="checkbox" name="window_types" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <fieldset class="qf__group">
        <legend>Where is the glass?</legend>
        <div class="qf__options">
          {
            positions.map((o) => (
              <label class="qf__option">
                <input type="checkbox" name="positions" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
    </fieldset>

    <!-- 4. Photos -->
    <fieldset class="qf__step" data-step="4">
      <legend><span class="qf__q" tabindex="-1">Add photos of the windows</span></legend>
      <p class="qf__sub">
        Up to {photoLimits.maxFiles} photos. A wide shot of each window helps us quote faster. Photos are resized on
        your device before sending.
      </p>
      <label class="qf__drop" for="qf-photos">
        <Icon name="camera" />
        <span><strong>Choose photos</strong> or take them now</span>
      </label>
      <input id="qf-photos" class="qf__file" type="file" name="photos" accept="image/*" multiple />
      <p class="qf__photo-status" data-photo-status aria-live="polite"></p>
      <ul class="qf__thumbs" data-thumbs></ul>
    </fieldset>

    <!-- 5. Location -->
    <fieldset class="qf__step" data-step="5">
      <legend><span class="qf__q" tabindex="-1">Where is the property?</span></legend>
      <p class="qf__sub">{site.serviceAreaLine}.</p>
      <div class="qf__row">
        <div class="qf__field">
          <label for="qf-postcode">Postcode</label>
          <input id="qf-postcode" name="postcode" type="text" autocomplete="postal-code" autocapitalize="characters" maxlength="10" />
        </div>
        <div class="qf__field">
          <label for="qf-town">Town</label>
          <input id="qf-town" name="town" type="text" autocomplete="address-level2" maxlength="80" />
        </div>
      </div>
    </fieldset>

    <!-- 6. Timing -->
    <fieldset class="qf__step" data-step="6">
      <legend><span class="qf__q" tabindex="-1">When would you like the work done?</span></legend>
      <div class="qf__options qf__options--cards">
        <label class="qf__option">
          <input type="radio" name="timing" value="flexible" />
          <span>I’m flexible</span>
        </label>
        <label class="qf__option">
          <input type="radio" name="timing" value="date" />
          <span>I have a date in mind</span>
        </label>
      </div>
      <div class="qf__field" data-date-field>
        <label for="qf-date">Preferred date</label>
        <input id="qf-date" name="date" type="date" />
      </div>
    </fieldset>

    <!-- 7. Contact details -->
    <fieldset class="qf__step" data-step="7">
      <legend><span class="qf__q" tabindex="-1">How can we contact you?</span></legend>
      <p class="qf__sub">We use these details only to reply to your request.</p>

      <div class="qf__field">
        <label for="qf-name">Name <span class="qf__req">(required)</span></label>
        <input id="qf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="qf-name-error" />
        <p class="qf__error" id="qf-name-error" hidden></p>
      </div>
      <div class="qf__row">
        <div class="qf__field">
          <label for="qf-email">Email <span class="qf__req">(required)</span></label>
          <input id="qf-email" name="email" type="email" autocomplete="email" required maxlength="200" aria-describedby="qf-email-error" />
          <p class="qf__error" id="qf-email-error" hidden></p>
        </div>
        <div class="qf__field">
          <label for="qf-phone">Phone</label>
          <input id="qf-phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="qf-phone-error" />
          <p class="qf__error" id="qf-phone-error" hidden></p>
        </div>
      </div>

      <fieldset class="qf__group">
        <legend>How would you prefer us to contact you?</legend>
        <div class="qf__options qf__options--inline">
          {
            contactMethods.map((o) => (
              <label class="qf__option">
                <input type="radio" name="contact_method" value={o.value} />
                <span>{o.label}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <div class="qf__field">
        <label for="qf-notes">Anything else we should know?</label>
        <textarea id="qf-notes" name="notes" rows="4" maxlength="3000"></textarea>
      </div>

      <div class="qf__field">
        <label class="qf__consent">
          <input type="checkbox" name="consent" value="yes" required aria-describedby="qf-consent-error" />
          <span>
            I agree to Eclipse Shield using these details to reply to my quote request, as described in the
            <a href="/privacy/" target="_blank">privacy policy</a> (opens in a new tab). <span class="qf__req">(required)</span>
          </span>
        </label>
        <p class="qf__error" id="qf-consent-error" hidden></p>
      </div>

    </fieldset>

    <p class="qf__ts-hint" data-turnstile-hint hidden>Quick check: please tick the box below to confirm you’re human.</p>
    <div class="qf__turnstile" data-turnstile></div>

    <p class="qf__form-error" data-form-error role="alert" hidden></p>

    <div class="qf__nav">
      <button type="button" class="btn btn--outline" data-back hidden>Back</button>
      <button type="button" class="btn btn--dark" data-next>Next</button>
      <button type="submit" class="btn btn--gold" data-submit hidden>Send my quote request</button>
    </div>
  </form>

  <div class="qf-done" data-done hidden>
    <div class="qf-done__icon" aria-hidden="true"><Icon name="shield" /></div>
    <h2 tabindex="-1">Thank you, we’ve got your request</h2>
    <p class="lead">We’ll get back to you the same day with a quote, or to arrange a free survey.</p>
    <p>
      Need to add something? Reply to our email, or email
      <a href={`mailto:${site.email}`}>{site.email}</a>{site.phone && <> or call <a href={telHref(site.phone)}>{site.phone}</a></>}.
    </p>
    <a class="btn btn--outline" href="/">Back to the home page</a>
  </div>
</div>

<script>
  type Turnstile = {
    render: (el: HTMLElement, opts: Record<string, unknown>) => string;
    reset: (id?: string) => void;
    getResponse: (id?: string) => string | undefined;
    isExpired: (id?: string) => boolean;
  };
  const w = window as unknown as Window & {
    dataLayer: Record<string, unknown>[];
    turnstile?: Turnstile;
    onTurnstileLoad?: () => void;
  };

  const form = document.querySelector<HTMLFormElement>('#quote-form');
  if (form) initQuoteForm(form);

  function initQuoteForm(form: HTMLFormElement) {
    const steps = [...form.querySelectorAll<HTMLFieldSetElement>('.qf__step')];
    const names = ['Property', 'What you need', 'Windows', 'Photos', 'Location', 'Timing', 'Your details'];
    const total = steps.length;
    const $ = <T extends Element>(sel: string) => form.querySelector<T>(sel)!;
    const backBtn = $<HTMLButtonElement>('[data-back]');
    const nextBtn = $<HTMLButtonElement>('[data-next]');
    const submitBtn = $<HTMLButtonElement>('[data-submit]');
    const formError = $<HTMLElement>('[data-form-error]');
    const done = document.querySelector<HTMLElement>('[data-done]')!;
    const maxFiles = Number(form.dataset.maxFiles);
    const resizeTo = Number(form.dataset.resize);
    let current = 0;
    let started = false;
    let turnstileId: string | undefined;
    const photos: { blob: Blob; name: string; url: string }[] = [];

    w.dataLayer = w.dataLayer || [];

    // ----- Prefill from links like /quote/?service=privacy-window-film or ?property=home -----
    const params = new URLSearchParams(location.search);
    const serviceMap: Record<string, string> = JSON.parse(form.dataset.serviceMap || '{}');
    const preInterest = serviceMap[params.get('service') || ''];
    if (preInterest) {
      const box = form.querySelector<HTMLInputElement>(`input[name="interests"][value="${preInterest}"]`);
      if (box) box.checked = true;
    }
    const preProperty = params.get('property');
    if (preProperty) {
      const radio = form.querySelector<HTMLInputElement>(`input[name="property_type"][value="${CSS.escape(preProperty)}"]`);
      if (radio) radio.checked = true;
    }
    const ref = document.referrer && new URL(document.referrer).origin === location.origin ? new URL(document.referrer).pathname : '';
    $<HTMLInputElement>('input[name="source"]').value = [ref, params.get('service')].filter(Boolean).join(' ');

    // ----- quote_start: first interaction with the form -----
    const markStarted = () => {
      if (started) return;
      started = true;
      w.dataLayer.push({ event: 'quote_start', form_name: 'quote' });
      renderTurnstile();
    };
    form.addEventListener('input', markStarted);
    form.addEventListener('change', markStarted);
    form.addEventListener('click', markStarted);

    // ----- Steps -----
    const show = (i: number, focus = true) => {
      current = i;
      steps.forEach((s, n) => (s.hidden = n !== i));
      $('[data-current]').textContent = String(i + 1);
      $('[data-step-name]').textContent = names[i];
      $<HTMLElement>('[data-bar]').style.width = `${((i + 1) / total) * 100}%`;
      backBtn.hidden = i === 0;
      nextBtn.hidden = i === total - 1;
      submitBtn.hidden = i !== total - 1;
      formError.hidden = true;
      if (focus) {
        steps[i].querySelector<HTMLElement>('.qf__q')?.focus({ preventScroll: true });
        form.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };
    nextBtn.addEventListener('click', () => show(Math.min(current + 1, total - 1)));
    backBtn.addEventListener('click', () => show(Math.max(current - 1, 0)));
    form.classList.add('qf--js');
    show(0, false);

    // Enter in a text field moves to the next step instead of submitting early.
    form.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === 'Enter' && t instanceof HTMLInputElement && current < total - 1) {
        e.preventDefault();
        show(current + 1);
      }
    });

    // ----- Timing: only show the date field when "date" is chosen -----
    const dateField = $<HTMLElement>('[data-date-field]');
    const dateInput = $<HTMLInputElement>('#qf-date');
    dateInput.min = new Date().toISOString().slice(0, 10);
    const syncDate = () => {
      const picked = form.querySelector<HTMLInputElement>('input[name="timing"]:checked')?.value;
      dateField.hidden = picked !== 'date';
    };
    form.querySelectorAll('input[name="timing"]').forEach((r) => r.addEventListener('change', syncDate));
    syncDate();

    // ----- Window size "not sure" -----
    const sizeInput = $<HTMLInputElement>('#qf-window-size');
    const notSure = $<HTMLInputElement>('input[name="window_size_not_sure"]');
    notSure.addEventListener('change', () => {
      sizeInput.disabled = notSure.checked;
      if (notSure.checked) sizeInput.value = '';
    });

    // ----- Photos: resize in the browser (also strips location data) -----
    const fileInput = $<HTMLInputElement>('#qf-photos');
    const thumbs = $<HTMLUListElement>('[data-thumbs]');
    const photoStatus = $<HTMLElement>('[data-photo-status]');

    const resize = async (file: File): Promise<Blob | null> => {
      try {
        const bitmap = await createImageBitmap(file, { imageOrientation: 'from-image' });
        const scale = Math.min(1, resizeTo / Math.max(bitmap.width, bitmap.height));
        const canvas = document.createElement('canvas');
        canvas.width = Math.round(bitmap.width * scale);
        canvas.height = Math.round(bitmap.height * scale);
        canvas.getContext('2d')!.drawImage(bitmap, 0, 0, canvas.width, canvas.height);
        bitmap.close();
        return await new Promise((resolve) => canvas.toBlob((b) => resolve(b), 'image/jpeg', 0.82));
      } catch {
        return null;
      }
    };

    const renderThumbs = () => {
      thumbs.replaceChildren(
        ...photos.map((p, i) => {
          const li = document.createElement('li');
          const img = document.createElement('img');
          img.src = p.url;
          img.alt = `Photo ${i + 1}`;
          img.width = 96;
          img.height = 96;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'qf__remove';
          btn.textContent = 'Remove';
          btn.setAttribute('aria-label', `Remove photo ${i + 1}`);
          btn.addEventListener('click', () => {
            URL.revokeObjectURL(p.url);
            photos.splice(i, 1);
            renderThumbs();
            photoStatus.textContent = `Photo removed. ${photos.length} of ${maxFiles} added.`;
            fileInput.focus();
          });
          li.append(img, btn);
          return li;
        }),
      );
    };

    fileInput.addEventListener('change', async () => {
      const files = [...(fileInput.files || [])];
      fileInput.value = '';
      const room = maxFiles - photos.length;
      if (room <= 0) {
        photoStatus.textContent = `You’ve already added ${maxFiles} photos. Remove one to add another.`;
        return;
      }
      photoStatus.textContent = 'Adding photos…';
      let skipped = files.length > room ? files.length - room : 0;
      for (const file of files.slice(0, room)) {
        let blob = await resize(file);
        // Some formats (e.g. HEIC outside Safari) can't be resized here. Send small originals as they are.
        if (!blob && file.type.startsWith('image/') && file.size <= 5 * 1024 * 1024) blob = file;
        if (!blob) {
          skipped++;
          continue;
        }
        photos.push({ blob, name: file.name.replace(/\.[^.]+$/, '') + '.jpg', url: URL.createObjectURL(blob) });
      }
      renderThumbs();
      photoStatus.textContent =
        `${photos.length} of ${maxFiles} photos added.` +
        (skipped ? ` ${skipped} couldn’t be added. Try JPG or PNG photos, or email them to us.` : '');
    });

    // ----- Turnstile -----
    // Starts quietly when someone begins the form, so a token is normally ready by the last step.
    // Tokens last 5 minutes and work once: the widget refreshes expired ones itself, and we reset it
    // after each use. If Cloudflare wants a tick in the box, a hint appears and sending waits for it.
    const tsBox = $<HTMLElement>('[data-turnstile]');
    const tsHint = $<HTMLElement>('[data-turnstile-hint]');
    let token = '';
    let turnstileError = '';
    let waiters: ((t: string) => void)[] = [];
    function renderTurnstile() {
      if (turnstileId !== undefined) return;
      if (!w.turnstile) return loadTurnstile();
      turnstileId = w.turnstile.render(tsBox, {
        sitekey: form.dataset.sitekey,
        appearance: 'interaction-only',
        theme: 'light',
        'refresh-expired': 'auto',
        callback: (t: string) => {
          token = t;
          turnstileError = '';
          tsHint.hidden = true;
          waiters.forEach((resolve) => resolve(t));
          waiters = [];
        },
        'expired-callback': () => {
          token = '';
        },
        'error-callback': (code: string) => {
          token = '';
          turnstileError = String(code);
        },
        'before-interactive-callback': () => {
          tsHint.hidden = false;
        },
        'after-interactive-callback': () => {
          tsHint.hidden = true;
        },
      });
    }
    // Take the current token (once), or wait up to timeoutMs for the next one.
    const takeToken = (timeoutMs: number) =>
      new Promise<string>((resolve) => {
        renderTurnstile();
        if (token) {
          const t = token;
          token = '';
          return resolve(t);
        }
        const onToken = (t: string) => {
          clearTimeout(timer);
          token = '';
          resolve(t);
        };
        const timer = setTimeout(() => {
          waiters = waiters.filter((x) => x !== onToken);
          resolve('');
        }, timeoutMs);
        waiters.push(onToken);
      });
    const resetTurnstile = () => {
      token = '';
      if (w.turnstile && turnstileId !== undefined) w.turnstile.reset(turnstileId);
    };
    function loadTurnstile() {
      if (document.querySelector('script[data-turnstile-script]')) return;
      w.onTurnstileLoad = () => renderTurnstile();
      const s = document.createElement('script');
      s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad';
      s.async = true;
      s.defer = true;
      s.dataset.turnstileScript = '';
      document.head.append(s);
    }

    // ----- Validation of the contact step -----
    const setError = (input: HTMLInputElement, message: string) => {
      const el = document.getElementById(`${input.id || 'qf-consent'}-error`) || form.querySelector<HTMLElement>('#qf-consent-error');
      input.setAttribute('aria-invalid', message ? 'true' : 'false');
      if (el) {
        el.textContent = message;
        el.hidden = !message;
      }
    };
    const fields = {
      name: $<HTMLInputElement>('#qf-name'),
      email: $<HTMLInputElement>('#qf-email'),
      phone: $<HTMLInputElement>('#qf-phone'),
      consent: $<HTMLInputElement>('input[name="consent"]'),
    };
    const validate = () => {
      const method = form.querySelector<HTMLInputElement>('input[name="contact_method"]:checked')?.value;
      const checks: [HTMLInputElement, string][] = [
        [fields.name, fields.name.value.trim() ? '' : 'Enter your name.'],
        [fields.email, /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(fields.email.value.trim()) ? '' : 'Enter a valid email address.'],
        [
          fields.phone,
          (method === 'phone' || method === 'text') && fields.phone.value.replace(/\D/g, '').length < 10
            ? 'Enter a phone number so we can call or text you.'
            : '',
        ],
        [fields.consent, fields.consent.checked ? '' : 'Tick the box to agree to the privacy policy.'],
      ];
      checks.forEach(([el, msg]) => setError(el, msg));
      const first = checks.find(([, msg]) => msg);
      first?.[0].focus();
      return !first;
    };
    Object.values(fields).forEach((el) =>
      el.addEventListener(el.type === 'checkbox' ? 'change' : 'input', () => {
        if (el.getAttribute('aria-invalid') === 'true') setError(el, '');
      }),
    );

    // ----- Submit -----
    let sending = false;
    const resetButton = () => {
      sending = false;
      submitBtn.disabled = false;
      submitBtn.textContent = 'Send my quote request';
    };
    const showError = (message: string) => {
      formError.textContent = message;
      formError.hidden = false;
    };

    // Wait for a spam-check token. If Cloudflare asks for a tick, keep waiting and send as soon as it's ticked.
    const waitForToken = async () => {
      const startedAt = Date.now();
      let pointedAtBox = false;
      while (Date.now() - startedAt < 180000) {
        const t = await takeToken(1000);
        if (t) return t;
        if (!tsHint.hidden) {
          submitBtn.textContent = 'Waiting for the tick…';
          showError('Nearly there. Tick the “Verify you are human” box above and your request will send automatically.');
          if (!pointedAtBox) {
            tsBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
            pointedAtBox = true;
          }
        } else if (Date.now() - startedAt > 20000 || (turnstileError && Date.now() - startedAt > 6000)) {
          return '';
        }
      }
      return '';
    };

    const post = async (t: string) => {
      const fd = new FormData(form);
      fd.delete('photos');
      photos.forEach((p) => fd.append('photos', p.blob, p.name));
      fd.set('cf-turnstile-response', t);
      const res = await fetch(form.action, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
      const data = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string; field?: string; codes?: string[] };
      return { ok: res.ok && data.ok === true, data, fd };
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;
      if (current !== total - 1) return show(total - 1);
      if (!validate()) return;

      sending = true;
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';
      formError.hidden = true;

      try {
        for (let attempt = 0; attempt < 2; attempt++) {
          const t = await waitForToken();
          if (!t) {
            resetTurnstile();
            return showError(
              (turnstileError
                ? `Our spam check couldn’t finish (code ${turnstileError}).`
                : 'Our spam check is taking longer than usual.') +
                ' Please press Send again, or call or email us.',
            );
          }
          formError.hidden = true;
          submitBtn.textContent = 'Sending…';
          const { ok, data, fd } = await post(t);
          resetTurnstile(); // tokens work once; get a fresh one for any further attempt

          if (ok) {
            // No personal data in analytics events.
            w.dataLayer.push({
              event: 'generate_lead',
              form_name: 'quote',
              property_type: String(fd.get('property_type') || 'not_given'),
              interests: fd.getAll('interests').join(',') || 'not_given',
              photo_count: photos.length,
            });
            form.hidden = true;
            done.hidden = false;
            done.querySelector<HTMLElement>('h2')?.focus();
            done.scrollIntoView({ behavior: 'smooth', block: 'start' });
            photos.forEach((p) => URL.revokeObjectURL(p.url));
            return;
          }

          // A spam-check problem (usually an expired token): try once more automatically.
          if (data.field === 'turnstile' && attempt === 0) continue;

          const message = (data.error || 'Sorry, your request didn’t send. Please try again, or call or email us.') +
            (data.codes?.length ? ` (code: ${data.codes.join(', ')})` : '');
          showError(message);
          const fieldEl = data.field && form.querySelector<HTMLInputElement>(`[name="${data.field}"]`);
          if (fieldEl && data.field !== 'photos' && data.field !== 'turnstile') {
            setError(fieldEl, data.error || '');
            fieldEl.focus();
          }
          return;
        }
      } catch {
        resetTurnstile();
        showError('Sorry, your request didn’t send. Please check your connection and try again, or call or email us. (code: network)');
      } finally {
        resetButton();
      }
    });
  }
</script>

