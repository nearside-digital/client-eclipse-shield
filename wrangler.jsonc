{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Eclipse Shield: static Astro site on Cloudflare Workers (Nearside Digital's account).
  // Pages are served from ./dist; only /api/* runs worker/index.ts (the quote form).
  // Secrets (set in the dashboard, kept across deploys): RESEND_API_KEY, TURNSTILE_SECRET_KEY.
  "name": "client-eclipse-shield",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // Live on eclipseshield.co.uk. A Worker route (with a proxied AAAA 100:: placeholder record) rather than a
  // custom domain, so it could be attached while the zone was still pending: no gap at the nameserver switch.
  // www → apex is a zone Redirect Rule, which runs before the Worker.
  "routes": [{ "pattern": "eclipseshield.co.uk/*", "zone_name": "eclipseshield.co.uk" }],
  "observability": { "enabled": true }
}
